{
  "name": "@viable-lab/engine",
  "version": "0.3.0",
  "description": "Run VIABLE yourself: AI tutors, courses, class lists and chat pages on your own server, on any model, with the VIABLE Harness inside.",
  "license": "MIT",
  "author": "Hongming (Chip) Li",
  "private": true,
  "type": "module",
  "main": "./engine/src/index.js",
  "exports": {
    ".": "./engine/src/index.js",
    "./package.json": "./package.json",
    "./harness": "./harness/src/index.js",
    "./harness/*": "./harness/src/*",
    "./*": "./engine/src/*"
  },
  "bin": {
    "viable-engine": "./engine/bin/viable-engine.mjs"
  },
  "files": [
    "engine/bin",
    "engine/src",
    "engine/dist",
    "engine/schemas",
    "engine/conformance",
    "engine/deploy",
    "engine/skills",
    "engine/docs",
    "engine/README.md",
    "harness/bin",
    "harness/src",
    "harness/schemas",
    "harness/conformance",
    "harness/skills",
    "harness/docs",
    "harness/README.md",
    "harness/package.json",
    "harness/integrations",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VIABLE-Learning-Lab/viable.git"
  },
  "dependencies": {
    "entities": "^9.0.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "marked": "18.0.14",
    "mermaid": "12.3.0",
    "pdfjs-dist": "6.5.438",
    "temml": "0.13.5"
  },
  "scripts": {
    "test": "node --import ./harness/test/no-network.js --test harness/test/*.test.js engine/test/*.test.js",
    "test:harness": "node --import ./harness/test/no-network.js --test harness/test/*.test.js",
    "test:engine": "node --import ./harness/test/no-network.js --test engine/test/*.test.js",
    "steps:build": "node engine/scripts/build-steps.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "xapi:build": "node harness/scripts/build-xapi-profile.mjs",
    "components:build": "node harness/scripts/build-component-pages.mjs",
    "catalog:build": "node harness/scripts/build-catalog-page.mjs",
    "fonts:build": "node harness/scripts/build-fonts.mjs",
    "build:assets": "node engine/scripts/build-learner-assets.mjs",
    "prepack": "node engine/scripts/build-learner-assets.mjs",
    "prepare": "node engine/scripts/prepare.mjs"
  }
}
