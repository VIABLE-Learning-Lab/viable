# Copy to .env. Every learner's message goes to this endpoint: have an agreement with its provider.
OPENAI_BASE_URL={{endpoint}}
OPENAI_API_KEY=
# What callers send (Authorization: Bearer ...). Make one: openssl rand -hex 32
VIABLE_ENGINE_TOKEN=
# The one web page origin allowed to call it from a browser, if any.
VIABLE_ENGINE_CORS=
{{#store}}# Delete what learners wrote, conversations and runs after this many days. Empty keeps them until you delete them.
VIABLE_ENGINE_KEEP_DAYS=180
VIABLE_ENGINE_DATA_DIR=./data
{{/store}}# IDs of MCP components this server may start, comma-separated. A package can't start one otherwise.
VIABLE_ENGINE_ALLOW_COMPONENTS=
HOST=127.0.0.1
PORT=8080
