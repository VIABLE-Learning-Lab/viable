{
  "suite": "expressions",
  "version": 1,
  "cases": [
    { "id": "precedence", "description": "* binds tighter than +.", "input": { "expression": "1 + 2 * 3" }, "expect": { "value": 7 } },
    { "id": "grouping", "description": "Parentheses group.", "input": { "expression": "(1 + 2) * 3" }, "expect": { "value": 9 } },
    { "id": "remainder", "description": "% is the remainder.", "input": { "expression": "17 % 5" }, "expect": { "value": 2 } },
    { "id": "string-concat", "description": "+ joins strings, in either quote.", "input": { "expression": "'Hello, ' + \"world\"" }, "expect": { "value": "Hello, world" } },
    { "id": "escaped-quote", "description": "A backslash escapes the next character in a string.", "input": { "expression": "'it\\'s'" }, "expect": { "value": "it's" } },
    { "id": "unary", "description": "! negates truth; - negates a number, reading text as one.", "input": { "expression": "[!true, !0, -x]", "scope": { "x": "3" } }, "expect": { "value": [false, true, -3] } },
    { "id": "path", "description": "A dotted path reads the scope.", "input": { "expression": "router.json.route", "scope": { "router": { "json": { "route": "hint" } } } }, "expect": { "value": "hint" } },
    { "id": "missing-path", "description": "A path that isn't there is null, never an error.", "input": { "expression": "vars.count.deep", "scope": { "vars": {} } }, "expect": { "value": null } },
    { "id": "no-prototype", "description": "Paths read own fields only: nothing inherited.", "input": { "expression": "[name.constructor, vars.toString]", "scope": { "name": "Ada", "vars": {} } }, "expect": { "value": [null, null] } },
    { "id": "index", "description": "Lists index from 0, and negative indexes count from the end.", "input": { "expression": "[items[0], items[-1], items[5]]", "scope": { "items": ["a", "b", "c"] } }, "expect": { "value": ["a", "c", null] } },
    { "id": "index-then-member", "description": "Indexing and members chain.", "input": { "expression": "items[1].prompt", "scope": { "items": [{ "prompt": "first" }, { "prompt": "second" }] } }, "expect": { "value": "second" } },
    { "id": "map-index", "description": "A map indexes by key.", "input": { "expression": "scores[\"Ada L\"]", "scope": { "scores": { "Ada L": 3 } } }, "expect": { "value": 3 } },
    { "id": "loose-equality", "description": "== compares loosely and === strictly.", "input": { "expression": "[1 == '1', 1 === '1', null == missing, 2 != 3]" }, "expect": { "value": [true, false, true, true] } },
    { "id": "relational", "description": "Comparisons work on numbers and text.", "input": { "expression": "[2 < 10, 'b' > 'a', 3 >= 3, 4 <= 3]" }, "expect": { "value": [true, true, true, false] } },
    { "id": "logical-values", "description": "|| and && give one of their sides, not only true or false.", "input": { "expression": "[name || 'friend', count && 'some', missing && 'x']", "scope": { "name": "", "count": 2 } }, "expect": { "value": ["friend", "some", null] } },
    { "id": "conditional", "description": "a ? b : c picks a side; nested ones read right to left.", "input": { "expression": "score > 8 ? 'high' : score > 4 ? 'middle' : 'low'", "scope": { "score": 6 } }, "expect": { "value": "middle" } },
    { "id": "list-and-map", "description": "List and map literals, with quoted keys and a trailing comma.", "input": { "expression": "{a: 1, 'b c': [1, 2,], }" }, "expect": { "value": { "a": 1, "b c": [1, 2] } } },
    { "id": "len", "description": "len counts a string's characters, a list's items and a map's keys; nothing is 0.", "input": { "expression": "[len('four'), len(items), len(map), len(missing)]", "scope": { "items": [1, 2, 3], "map": { "a": 1 } } }, "expect": { "value": [4, 3, 1, 0] } },
    { "id": "default", "description": "default replaces null or empty text, but not 0 or false.", "input": { "expression": "[default(missing, 'x'), default('', 'x'), default(0, 'x'), default(false, 'x')]" }, "expect": { "value": ["x", "x", 0, false] } },
    { "id": "text-helpers", "description": "lower, upper, trim and capitalize.", "input": { "expression": "[lower('AbC'), upper('abc'), trim('  a  '), capitalize('fraction')]" }, "expect": { "value": ["abc", "ABC", "a", "Fraction"] } },
    { "id": "contains", "description": "contains is case-insensitive in text, exact in a list.", "input": { "expression": "[contains('Hello', 'ELL'), contains(['a', 'b'], 'b'), contains(['A'], 'a')]" }, "expect": { "value": [true, true, false] } },
    { "id": "split-join", "description": "split trims and drops empty parts; join uses ', ' unless told.", "input": { "expression": "[split('a, b,,c'), join(['x', 'y']), join(['x', 'y'], ' / ')]" }, "expect": { "value": [["a", "b", "c"], "x, y", "x / y"] } },
    { "id": "number", "description": "number reads a number from text, and 0 when it can't.", "input": { "expression": "[number('2.5'), number('abc'), number(true)]" }, "expect": { "value": [2.5, 0, 1] } },
    { "id": "string-of-object", "description": "string and json write a map as JSON.", "input": { "expression": "[string(5), json(map)]", "scope": { "map": { "a": [1, 2] } } }, "expect": { "value": ["5", "{\"a\":[1,2]}"] } },
    { "id": "round-min-max", "description": "round to places; min and max of two.", "input": { "expression": "[round(3.14159, 2), round(2.5), min(3, 7), max(3, 7)]" }, "expect": { "value": [3.14, 3, 3, 7] } },
    { "id": "first-last-slice", "description": "first, last and slice of lists and text.", "input": { "expression": "[first(items), last(items), slice(items, 1), slice('fraction', 0, 4)]", "scope": { "items": [1, 2, 3] } }, "expect": { "value": [1, 3, [2, 3], "frac"] } },
    { "id": "keys-append-concat", "description": "keys of a map, append an item, concat two lists.", "input": { "expression": "[keys(map), append(items, 3), concat(items, [9])]", "scope": { "map": { "a": 1, "b": 2 }, "items": [1, 2] } }, "expect": { "value": [["a", "b"], [1, 2, 3], [1, 2, 9]] } },
    { "id": "if", "description": "if(cond, a, b).", "input": { "expression": "[if(ok, 'yes', 'no'), if(missing, 'yes', 'no'), if(false, 'yes')]", "scope": { "ok": true } }, "expect": { "value": ["yes", "no", null] } },
    { "id": "empty", "description": "empty: null, blank text, an empty list or map.", "input": { "expression": "[empty(missing), empty('  '), empty([]), empty({}), empty(0), empty('a')]" }, "expect": { "value": [true, true, true, true, false, false] } },
    {
      "id": "where-count-find", "description": "where, count, without and find match an item's field, comparing plain values by their text.",
      "input": { "expression": "[pluck(where(items, 'done', true), 'n'), count(items, 'n', '2'), count(items), pluck(without(items, 'done'), 'n'), find(items, 'n', 3).done]", "scope": { "items": [{ "n": 1, "done": true }, { "n": 2, "done": false }, { "n": 3, "done": true }] } },
      "expect": { "value": [[1, 3], 1, 3, [2], true] }
    },
    { "id": "pluck-dotted", "description": "pluck reads a dotted field.", "input": { "expression": "pluck(items, 'source.number')", "scope": { "items": [{ "source": { "number": 1 } }, { "source": { "number": 4 } }, {}] } }, "expect": { "value": [1, 4, null] } },
    { "id": "sum", "description": "sum of a list, or of a field, counting what isn't a number as 0.", "input": { "expression": "[sum([1, 2, 3]), sum(items, 'points')]", "scope": { "items": [{ "points": 2 }, { "points": "3" }, { "points": "x" }] } }, "expect": { "value": [6, 5] } },
    { "id": "numbers", "description": "numbers(from, to) counts either way, both ends included.", "input": { "expression": "[numbers(1, 4), numbers(3, 1)]" }, "expect": { "value": [[1, 2, 3, 4], [3, 2, 1]] } },
    { "id": "compact-unique", "description": "compact drops null, empty text and false; unique keeps first appearances.", "input": { "expression": "[compact([0, '', null, false, 'a']), unique([1, '1', 1, 'a', 'a'])]" }, "expect": { "value": [[0, "a"], [1, "1", "a"]] } },
    { "id": "sort-reverse", "description": "sort numbers by value and text alphabetically, or by a field; reverse.", "input": { "expression": "[sort([10, 9, 1]), pluck(sort(items, 'name'), 'name'), reverse([1, 2, 3])]", "scope": { "items": [{ "name": "b" }, { "name": "a" }] } }, "expect": { "value": [[1, 9, 10], ["a", "b"], [3, 2, 1]] } },
    { "id": "merge", "description": "merge combines two maps, the second winning.", "input": { "expression": "merge({a: 1, b: 2}, {b: 3})" }, "expect": { "value": { "a": 1, "b": 3 } } },
    { "id": "and-list", "description": "and_list writes a list as a phrase.", "input": { "expression": "[and_list(['x', 'y', 'z']), and_list(['x', 'y'], 'or'), and_list(['x'])]" }, "expect": { "value": ["x, y and z", "x or y", "x"] } },
    { "id": "plural", "description": "plural picks the word for a count.", "input": { "expression": "[plural(2, 'picture'), plural(1, 'child', 'children'), plural(3, 'child', 'children')]" }, "expect": { "value": ["pictures", "child", "children"] } },
    { "id": "unknown-function", "description": "Only the listed functions exist.", "input": { "expression": "eval('1')" }, "expect": { "error": true } },
    { "id": "syntax-error", "description": "An incomplete expression is an error.", "input": { "expression": "1 +" }, "expect": { "error": true } },
    { "id": "trailing-token", "description": "Leftover tokens are an error.", "input": { "expression": "1 2" }, "expect": { "error": true } },
    { "id": "proto-key", "description": "A map can't have a __proto__ key.", "input": { "expression": "{'__proto__': 1}" }, "expect": { "error": true } },
    { "id": "template", "description": "A template fills each {{ }} with its expression's value.", "input": { "template": "Hi {{ name }}, you have {{ len(items) }} {{ plural(len(items), 'task') }}.", "scope": { "name": "Ada", "items": [1, 2] } }, "expect": { "text": "Hi Ada, you have 2 tasks." } },
    { "id": "template-values", "description": "In a template, nothing is empty text and a map is JSON.", "input": { "template": "[{{ missing }}] {{ map }}", "scope": { "map": { "a": 1 } } }, "expect": { "text": "[] {\"a\":1}" } },
    { "id": "template-braces", "description": "A }} inside quotes or a map doesn't end the placeholder.", "input": { "template": "{{ default(x, \"}}\") }} {{ {a: 1}.a }}" }, "expect": { "text": "}} 1" } },
    { "id": "template-sealed-answer-key", "description": "Writing out the whole context leaves out its answer key, so a reply step can't be handed it by accident.", "input": { "template": "{{ context }} / {{ context.answer_key }}", "scope": { "context": { "question": "1/2 + 1/3?", "answer_key": "5/6" } } }, "expect": { "text": "{\"question\":\"1/2 + 1/3?\"} / 5/6" } }
  ]
}
