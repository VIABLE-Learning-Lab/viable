{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developers.viablelab.org/schemas/course-package.schema.json",
  "title": "VIABLE course package",
  "description": "A course with the agents and question sets its activities use, as one JSON file (format viable.course-package, version 1), or as a .viable.zip with that file at its root as package.viable.json and the files it names under files/. Parts refer to each other by ref, never by a project's IDs. Files come by https url or by path in the zip; knowledge bases hold files and websites, Reading panels name a PDF by file_ref, and agents' Knowledge and Agent steps name knowledge bases by knowledge_base_refs. With no course, it is one or more agents with their knowledge and chat pages: an agent downloaded on its own, and importing it makes no course. A server may also hold knowledge bases that no agent uses yet. A package never carries learners, class lists, sections, keys, logs or study data; what an export left out it says in notes. Fields other than these (such as an example's guide) are ignored on import. `viable-engine validate` also runs VIABLE's graph checks on each agent and checks that every ref resolves.",
  "type": "object",
  "required": [
    "format",
    "version"
  ],
  "anyOf": [
    {
      "required": [
        "course"
      ]
    },
    {
      "required": [
        "agents"
      ],
      "properties": {
        "agents": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "knowledge_bases"
      ],
      "properties": {
        "knowledge_bases": {
          "minItems": 1
        }
      }
    }
  ],
  "properties": {
    "format": {
      "const": "viable.course-package"
    },
    "version": {
      "const": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "guide": {
      "type": "string",
      "description": "For examples: who it is for and what to change first."
    },
    "agents": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "name",
          "graph"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
            "description": "Its slug where the package was downloaded from, once published there. A server running the package answers at it; an import gives the agent a new one."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "graph": {
            "$ref": "agent.schema.json#/$defs/graph"
          },
          "profile": {
            "$ref": "agent.schema.json#/properties/profile"
          },
          "chat_page": {
            "$ref": "agent.schema.json#/$defs/chat_page"
          }
        }
      }
    },
    "question_sets": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "title",
          "items"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/question"
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "name"
        ],
        "description": "A file, downloaded from its https url on import or found by its path in the .viable.zip (one of the two). bytes and sha256, when given, must match.",
        "properties": {
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Its file name, with an extension a knowledge base reads."
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "text_path": {
            "type": "string",
            "minLength": 1,
            "description": "Where a Markdown copy of the file's text is, as path is (in the .viable.zip, or the package's folder): the passages VIABLE read from a PDF or Office file, in order, for a reader that can't read the file's own format. VIABLE writes one when it packages such a file, and reads the file itself on import."
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$",
            "description": "The text copy's sha256, which must match it."
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ]
      }
    },
    "knowledge_bases": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "name"
        ],
        "properties": {
          "ref": {
            "$ref": "#/$defs/ref"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "search_mode": {
            "enum": [
              "hybrid",
              "keyword"
            ],
            "description": "How VIABLE searches it: by keywords and meaning, or keywords only. Elsewhere a knowledge base may search only by keywords."
          },
          "file_refs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "file_links": {
            "type": "boolean",
            "description": "Citations may link to its files: a server running the package serves them to anyone with the link."
          },
          "websites": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "url"
              ],
              "description": "Read and indexed after import: a crawl from url (the default), a sitemap, or a list of pages (urls).",
              "properties": {
                "kind": {
                  "enum": [
                    "crawl",
                    "sitemap",
                    "list"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "path_prefix": {
                  "type": "string",
                  "pattern": "^https://",
                  "description": "Only pages whose address starts with this."
                },
                "include_subpages": {
                  "type": "boolean",
                  "description": "A sitemap's pages also bring the sub-pages in their guide's navigation."
                },
                "max_pages": {
                  "type": "integer",
                  "minimum": 1
                },
                "refresh_hours": {
                  "enum": [
                    0,
                    24,
                    168,
                    720,
                    4380,
                    8760
                  ]
                },
                "snapshot": {
                  "type": "array",
                  "description": "The pages as they were last read, each a Markdown file by its path, as a file's is. A server running the package searches these and cites url; an import reads the site again instead.",
                  "items": {
                    "type": "object",
                    "required": [
                      "url",
                      "path"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^https://"
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      },
                      "read_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "course": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "enum": [
            "adults",
            "teens",
            "children"
          ]
        },
        "identify": {
          "enum": [
            "browser",
            "ask",
            "code",
            "link"
          ]
        },
        "identify_ask": {
          "type": [
            "string",
            "null"
          ]
        },
        "identify_match": {
          "enum": [
            "any",
            "roster"
          ],
          "description": "With identify ask: any typed entry, or only those on the class list, which stays on the server that holds it."
        },
        "shared_devices": {
          "type": "boolean",
          "description": "Learners share computers: who is here is asked again on each visit."
        },
        "sections_from": {
          "enum": [
            "none",
            "link",
            "roster",
            "choose"
          ]
        },
        "data_level": {
          "enum": [
            "minimal",
            "process",
            "detailed"
          ]
        },
        "keep_recordings": {
          "type": "boolean"
        },
        "learner_daily_messages": {
          "type": [
            "integer",
            "null"
          ]
        },
        "time_zone": {
          "type": "string"
        },
        "appearance": {
          "type": [
            "object",
            "null"
          ]
        },
        "info": {
          "type": [
            "object",
            "null"
          ]
        },
        "units": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "required": [
              "ref",
              "title"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/ref"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "starts_on": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "ends_on": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            }
          }
        },
        "activities": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "Its address on a server of your own, kept when its title changes. An import on VIABLE gives it a new one."
        }
      }
    },
    "attribution": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The attributions its standards and skills carry (CC BY 4.0)."
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the export left out."
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "question": {
      "type": "object",
      "required": [
        "type",
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$"
        },
        "type": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array"
        },
        "answer": {},
        "language": {
          "type": "string"
        },
        "starter": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "points": {
          "type": "number"
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "explanation": {
          "type": "string"
        },
        "max_seconds": {
          "type": "integer"
        },
        "rubric": {
          "type": "string"
        },
        "show_model": {
          "type": "boolean"
        }
      }
    },
    "activity": {
      "type": "object",
      "required": [
        "title"
      ],
      "description": "An activity with refs: unit_ref, agent_ref, set_ref in place of a Questions panel's set_id, and file_ref (a PDF) in place of a Reading panel's document. A Reading panel without file_ref is left out on import.",
      "properties": {
        "unit_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "instruction",
            "pretest",
            "posttest",
            "survey"
          ]
        },
        "agent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/workspace"
            }
          ]
        },
        "survey": {
          "type": [
            "object",
            "null"
          ]
        },
        "minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "voice": {
          "type": [
            "object",
            "null"
          ]
        },
        "attachments": {
          "type": [
            "object",
            "null"
          ]
        },
        "teaching": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "teaching.schema.json"
            }
          ]
        },
        "release": {
          "enum": [
            "open",
            "hidden"
          ]
        },
        "done_when": {
          "enum": [
            "auto",
            "self",
            "opened"
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "Its address in the course on a server of your own, kept when its title changes."
        },
        "opens_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "With release hidden: it opens at this time, on a server of your own. An import on VIABLE leaves it hidden."
        },
        "closes_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When it closes, on a server of your own."
        }
      }
    },
    "workspace": {
      "type": "object",
      "description": "What the learner has open beside the AI: panels shown as tabs, and optional steps that open them in turn.",
      "properties": {
        "ai": {
          "enum": [
            "right",
            "left",
            "corner",
            "off"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "layout": {
          "type": [
            "object",
            "null"
          ]
        },
        "panels": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "writing",
                  "embed",
                  "questions",
                  "reading"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 60
              },
              "set_ref": {
                "$ref": "#/$defs/ref"
              },
              "file_ref": {
                "$ref": "#/$defs/ref"
              }
            },
            "if": {
              "properties": {
                "type": {
                  "const": "questions"
                }
              }
            },
            "then": {
              "required": [
                "set_ref"
              ]
            }
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
