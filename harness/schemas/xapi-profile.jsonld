{
  "@context": "https://w3id.org/xapi/profiles/context",
  "id": "https://developers.viablelab.org/xapi",
  "type": "Profile",
  "conformsTo": "https://w3id.org/xapi/profiles#1.0",
  "prefLabel": {
    "en": "VIABLE learning events"
  },
  "definition": {
    "en": "How the VIABLE harness writes one learner’s learning events and messages to the AI as xAPI 1.0.3 statements: VIABLE’s own verbs, activity types and extensions. Statements use ADL’s verbs and its question and objective activity types where they fit. An embedded page’s own verb that ADL lacks, and an app’s own event fields, are named under this profile’s verbs/ and extensions/ too, and are not defined here."
  },
  "versions": [
    {
      "id": "https://developers.viablelab.org/xapi/v1",
      "generatedAtTime": "2026-11-03T00:00:00Z"
    }
  ],
  "author": {
    "type": "Organization",
    "name": "VIABLE Lab",
    "url": "https://viablelab.org"
  },
  "concepts": [
    {
      "id": "https://developers.viablelab.org/xapi/verbs/saved",
      "type": "Verb",
      "inScheme": "https://developers.viablelab.org/xapi/v1",
      "prefLabel": {
        "en": "saved"
      },
      "definition": {
        "en": "Saved a snapshot of their plan or draft: the text as it stood when they paused writing."
      }
    },
    {
      "id": "https://developers.viablelab.org/xapi/verbs/checked",
      "type": "Verb",
      "inScheme": "https://developers.viablelab.org/xapi/v1",
      "prefLabel": {
        "en": "checked"
      },
      "definition": {
        "en": "Ticked a criterion of the rubric as met by their writing."
      }
    },
    {
      "id": "https://developers.viablelab.org/xapi/verbs/unchecked",
